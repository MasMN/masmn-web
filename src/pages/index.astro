<script>
  const select = document.querySelector<HTMLSelectElement>('#prayer-masjid-select');
  const container = document.querySelector<HTMLElement>('[data-role="home-prayer-times"]');

  select?.addEventListener('change', () => {
    if (!container) return;
    container.dataset.masjidId = select.value;
    container.dispatchEvent(new CustomEvent('prayertimes:refresh'));
  });

  /* ---------------------------------------------------------------------
     Hero: pointer parallax
     Feeds normalised -1..1 pointer coordinates to the hero as CSS vars so
     the orbs drift and the arch tilts with the cursor.
     --------------------------------------------------------------------- */
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const hero = document.querySelector<HTMLElement>('.hero');

  if (hero && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let frame = 0;

    const track = (event: PointerEvent) => {
      if (prefersReducedMotion.matches) return;
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const rect = hero.getBoundingClientRect();
        hero.style.setProperty('--px', String(((event.clientX - rect.left) / rect.width) * 2 - 1));
        hero.style.setProperty('--py', String(((event.clientY - rect.top) / rect.height) * 2 - 1));
      });
    };

    const reset = () => {
      hero.style.setProperty('--px', '0');
      hero.style.setProperty('--py', '0');
    };

    hero.addEventListener('pointermove', track);
    hero.addEventListener('pointerleave', reset);
  }

  /* ---------------------------------------------------------------------
     Hero: live next-prayer countdown
     --------------------------------------------------------------------- */
  const prayerCard = document.querySelector<HTMLAnchorElement>('[data-role="hero-next-prayer"]');

  interface HeroSalah {
    fajr?: string;
    zuhr?: string;
    asr?: string;
    maghrib?: string;
    isha?: string;
  }

  /** Turns an API time like "5:12 AM" into a Date on `dayOffset` days from today. */
  function toDate(raw: string | undefined, dayOffset = 0): Date | null {
    const match = raw?.trim().match(/^(\d{1,2}):(\d{2})\s*([ap]m)?$/i);
    if (!match) return null;

    let hours = Number(match[1]);
    const minutes = Number(match[2]);
    const meridiem = match[3]?.toLowerCase();

    if (meridiem === 'pm' && hours !== 12) hours += 12;
    if (meridiem === 'am' && hours === 12) hours = 0;

    const date = new Date();
    date.setDate(date.getDate() + dayOffset);
    date.setHours(hours, minutes, 0, 0);
    return date;
  }

  function formatClock(date: Date): string {
    return date
      .toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })
      .replace(/\s?(AM|PM)/i, (_, part: string) => ` ${part.toLowerCase()}`);
  }

  function formatCountdown(ms: number): string {
    const totalMinutes = Math.floor(ms / 60000);
    const hours = Math.floor(totalMinutes / 60);
    const minutes = totalMinutes % 60;
    const seconds = Math.floor(ms / 1000) % 60;
    if (hours > 0) return `in ${hours}h ${String(minutes).padStart(2, '0')}m`;
    if (minutes > 0) return `in ${minutes}m ${String(seconds).padStart(2, '0')}s`;
    return `in ${seconds}s`;
  }

  async function initHeroPrayer(card: HTMLAnchorElement) {
    const masjidId = card.dataset.masjidId;
    const nameEl = card.querySelector<HTMLElement>('[data-role="prayer-name"]');
    const timeEl = card.querySelector<HTMLElement>('[data-role="prayer-time"]');
    const countEl = card.querySelector<HTMLElement>('[data-role="prayer-count"]');
    if (!masjidId || !nameEl || !timeEl || !countEl) return;

    let salah: HeroSalah | undefined;
    try {
      const response = await fetch(`https://masjidal.com/api/v1/time/range?masjid_id=${masjidId}`);
      if (!response.ok) throw new Error(`Request failed with ${response.status}`);
      salah = (await response.json())?.data?.salah?.[0];
    } catch {
      return; // Leave the card's static "Prayer times" fallback in place.
    }

    if (!salah) return;

    const schedule: Array<[string, string | undefined]> = [
      ['Fajr', salah.fajr],
      ['Dhuhr', salah.zuhr],
      ['Asr', salah.asr],
      ['Maghrib', salah.maghrib],
      ['Isha', salah.isha],
    ];

    const tick = () => {
      const now = Date.now();
      const upcoming = schedule
        .map(([name, raw]) => ({ name, at: toDate(raw) }))
        .filter((entry): entry is { name: string; at: Date } => entry.at !== null)
        .find((entry) => entry.at.getTime() > now);

      // Past Isha, roll over to tomorrow's Fajr.
      const next = upcoming ?? (() => {
        const at = toDate(salah?.fajr, 1);
        return at ? { name: 'Fajr', at } : null;
      })();

      if (!next) return;

      nameEl.textContent = next.name;
      timeEl.textContent = formatClock(next.at);
      countEl.textContent = formatCountdown(next.at.getTime() - now);
    };

    tick();
    window.setInterval(tick, 1000);
  }

  if (prayerCard) initHeroPrayer(prayerCard);
</script>
