---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { programs } from '../../data/programs';
import { siteInfo } from '../../data/site';

export function getStaticPaths() {
  return programs.map((program) => ({
    params: { slug: program.slug },
    props: { program },
  }));
}

const { program } = Astro.props;
---

<BaseLayout title={program.name} description={program.summary}>
  <PageHero eyebrow={program.category} title={program.name} lede={program.summary} />

  <section class="section">
    <div class="container detail-grid">
      <div>
        <h2>Overview</h2>
        <p>{program.description}</p>
        {
          program.highlights && (
            <ul class="highlights">
              {program.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          )
        }
      </div>
      <div class="card detail-card">
        <h3>Get Involved</h3>
        <p>Interested in this program? Reach out to the MAS Minnesota office to learn how to participate or volunteer.</p>
        <p>
          <a href={siteInfo.phoneHref}>{siteInfo.phone}</a><br />
          <a href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a>
        </p>
        <a href="/programs/" class="btn btn-outline-dark">&larr; All Programs</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .highlights {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .highlights li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--color-ink-700);
  }

  .highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-green-700);
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
  }

  .detail-card {
    height: fit-content;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (max-width: 800px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
